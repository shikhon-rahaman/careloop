# =============================================================================
# CareLoop Environment Configuration Template (.env.example)
#
# Copy this file to '.env' if you wish to override defaults:
#   cp .env.example .env
#
# NOTE: All settings have safe defaults. The application runs out of the box
# with NO .env file required. Never commit real credentials to version control.
# =============================================================================

# Server network port (default: 8000)
PORT=8000

# Server network bind host (default: 0.0.0.0)
HOST=0.0.0.0

# SQLite database file path (default: careloop.db in project root)
CARELOOP_DB_PATH=careloop.db

# Optional: Telegram Emergency Notification Bot Token
# Obtain from @BotFather on Telegram. Leave blank to disable Telegram alerts.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Telegram Chat or Channel ID where alerts will be delivered
# Obtain from @userinfobot or channel ID. Leave blank to disable Telegram alerts.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
